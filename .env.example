# Public Supabase project connection values. Never place the service-role key here.
VITE_SUPABASE_URL=https://your-project-reference.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public canonical website address, required for local production builds.
# Cloudflare Pages supplies CF_PAGES_URL if this is omitted in its dashboard.
# Set this to the final custom domain when it is connected, then rebuild.
VITE_SITE_URL=https://your-production-domain.example
